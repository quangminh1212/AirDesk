# ---------------------------------------------------------------------------
# AirDesk backend configuration. Copy to `.env` and fill in values.
# NOTHING here is secret by default; never commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://airdesk:airdesk@localhost:5432/airdesk
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis (optional; in-process cache used when unset) --------------------
REDIS_URL=redis://localhost:6379/0

# --- LLM (LiteLLM is the single gateway for every model call) --------------
# Model uses LiteLLM's "provider/model" convention. The prefix selects the wire
# protocol LiteLLM uses, which MUST match what the endpoint at LLM_API_BASE
# actually serves -- it is not necessarily the model vendor. A gateway that
# speaks a Claude-compatible protocol but hosts other model families still
# needs the prefix it implements.
#
# Getting this wrong is a silent failure mode, not a startup error: against
# some proxies a mismatched prefix returns a syntactically valid response whose
# tool_calls are present but empty. That used to surface as the agent calling a
# tool named "" and escalating every request. The gateway now raises a
# ProviderError naming LLM_MODEL when it sees a blank tool name.
LLM_MODEL=openai/gpt-4o-mini
# Comma-separated fallback chain, e.g. gemini/gemini-1.5-pro,openai/gpt-4o
LLM_FALLBACK_MODELS=
# Point this at your LiteLLM proxy to avoid direct provider SDKs.
LLM_API_BASE=
# Provider key(s). LiteLLM reads OPENAI_API_KEY / ANTHROPIC_API_KEY too.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# --- Flight providers ------------------------------------------------------
# Which providers to try, in order.
#   opensky : FREE, NO LOGIN needed. Live Vietnamese flight data from the
#             OpenSky Network (anonymous API). Fares are distance estimates.
#   mock    : deterministic offline fixture (always works, no network).
#   amadeus : Amadeus Self-Service; REQUIRES an account/API key.
#   duffel  : Duffel; REQUIRES an account/API token.
FLIGHT_PROVIDERS=opensky,mock,amadeus

# OpenSky Network: no credentials required. Optional contact for higher limits.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Amadeus Self-Service (free test env with Vietnamese carriers)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Duffel (secondary provider; covers Vietnam Airlines)
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=3

# --- Messaging integrations (optional; app degrades gracefully) ------------
# Zalo OA: send via ZALO_OA_ACCESS_TOKEN. Inbound webhooks are verified with
# sha256(app_id + raw_body + timestamp + app_secret); set both to enable.
ZALO_OA_ACCESS_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Facebook Messenger: FACEBOOK_PAGE_ACCESS_TOKEN sends; FACEBOOK_VERIFY_TOKEN is
# the GET handshake token; FACEBOOK_APP_SECRET verifies X-Hub-Signature-256.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
# Refuse inbound webhooks whose signature cannot be verified (default true).
# Only set false for local debugging -- never in production.
WEBHOOK_REQUIRE_SIGNATURE=true

# --- Email / SMTP (outbound) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@airdesk.local

# --- Email / IMAP (inbound; optional) ---------------------------------------
# Poll this mailbox for customer email. Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# How many recent messages to scan per poll.
IMAP_MAX_MESSAGES=25
# Set true to poll automatically in the background scheduler.
EMAIL_POLL_ENABLED=false
# Whether the agent may send a reply automatically, or only draft one.
EMAIL_AUTO_REPLY_ENABLED=true

# --- Document processing ----------------------------------------------------
# Max upload size in bytes (default 10 MB).
DOCUMENT_MAX_BYTES=10485760
# Comma-separated allow-list of accepted MIME types.
DOCUMENT_ALLOWED_TYPES=application/pdf,text/plain,text/csv,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# --- Guardrails / human-in-the-loop ----------------------------------------
# Bookings above this total (VND) require a human operator's approval.
BOOKING_AUTO_APPROVE_LIMIT_VND=20000000
# Consignments above this declared value (VND) require approval. Higher than
# the booking ceiling because cargo legitimately carries more value. Dangerous
# goods always need approval regardless of value.
SHIPMENT_AUTO_APPROVE_LIMIT_VND=50000000
# Agent answers below this self-confidence are escalated to a human.
AGENT_CONFIDENCE_THRESHOLD=0.75

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
