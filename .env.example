# =============================================================================
# AirDesk — sample environment configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" (in the project root) and fill in real values before
# running `docker compose up --build`. Every variable below is read by
# docker-compose.yml and forwarded to the api / worker services.
#
# NOTE: secret / credential values are placeholders. NEVER commit a populated
# ".env" — it is git-ignored. This ".env.example" is tracked on purpose so the
# configuration contract stays in version control.
# =============================================================================

# --- Core runtime -----------------------------------------------------------
# Set to "production" for real deployments. In production mode the app refuses
# to boot with insecure defaults (e.g. the dev-only SECRET_KEY).
ENVIRONMENT=development

# CRITICAL: must be a long, random string in production. The value below is the
# dev-only default and is rejected when ENVIRONMENT=production.
SECRET_KEY=dev-only-insecure-secret-change-me

# Comma-separated list of allowed CORS origins (no spaces). Frontend is served
# from nginx on :8080, so it is allowed by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host port mappings (optional overrides for docker compose).
API_PORT=8000
WEB_PORT=8080

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=airdesk
# CHANGE THIS. Used by both the api and worker services.
POSTGRES_PASSWORD=airdesk
POSTGRES_DB=airdesk

# --- Redis ------------------------------------------------------------------
# REDIS_URL is hardcoded to the compose service name inside docker-compose.yml
# (redis://redis:6379/0). Override here only if you run Redis elsewhere.
# REDIS_URL=redis://redis:6379/0

# --- LLM gateway (LiteLLM-compatible) --------------------------------------
# BẬT AI CHỈ CẦN 2 DÒNG: LLM_API_KEY + LLM_API_BASE.
#   - LLM_MODEL   : KHÔNG cần điền. Để trống sẽ dùng mặc định
#                   "anthropic/claude-sonnet-4-5" (ghi "LLM_MODEL=" cũng OK,
#                   code tự fallback về mặc định).
#   - LLM_FALLBACK_MODELS : KHÔNG cần điền (để trống = không có model dự phòng).
# Cả api và worker đều cần 2 biến này: worker phân loại email đến, api chạy
# agent trò chuyện.
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
# Optional comma-separated fallback models if the primary is unavailable.
LLM_FALLBACK_MODELS=

# --- Flight inventory providers ---------------------------------------------
# Comma-separated. "mock" is a deterministic offline provider; "opensky" needs
# network; "amadeus" needs AMADEUS credentials (see below).
FLIGHT_PROVIDERS=opensky,mock

# --- Inbound email (optional) ----------------------------------------------
# Leave IMAP_HOST empty to disable email ingestion entirely. When enabled, the
# worker's beat polls the mailbox every 5 minutes and (optionally) auto-replies.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Max messages fetched per poll cycle.
# IMAP_MAX_MESSAGES=25

# SMTP used for auto-replies (and any outbound email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@airdesk.local

# Gate the scheduled email poll: OFF by default, operator opts in.
EMAIL_POLL_ENABLED=false
# Whether the worker may send auto-replies when it classifies an email.
EMAIL_AUTO_REPLY_ENABLED=true

# --- Webhooks ---------------------------------------------------------------
# Enforce HMAC signature verification on inbound webhooks. Keep true in prod.
WEBHOOK_REQUIRE_SIGNATURE=true

# --- Amadeus (only needed if "amadeus" is in FLIGHT_PROVIDERS) --------------
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
